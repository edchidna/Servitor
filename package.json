{
  "name": "spacemarineaar",
  "version": "1.0.0",
  "description": "Space Marine 2 After Action Report Discord Bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "backup": "node backup-database.js",
    "migrate:sqlite-to-turso": "node migrate-sqlite-to-turso.js",
